
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daki-ai-assistant",
  "main": "worker.js",
  "compatibility_date": "2026-11-26",
  "workers_dev": true,

  "ai": {
    "binding": "AI"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daki-db",
      "database_id": "4b8838ad-bcda-4809-b669-227183afa667"
    }
  ],

  "previews": {
    "ai": {
      "binding": "AI"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "daki-db-preview",
        "database_id": "ed239cad-6583-4a3e-82e3-a804b161b5dd"
      }
    ]
  }
}
